/* app.wxss - 全局样式 */

/* CSS 变量 */
page {
  --primary-color: #FFD100;
  --primary-dark: #F5C000;
  --primary-light: #FFF8E1;
  --text-primary: #1A1A1A;
  --text-secondary: #666666;
  --text-hint: #999999;
  --bg-primary: #F5F5F5;
  --bg-card: #FFFFFF;
  --bg-hover: #F0F0F0;
  --border-color: #EEEEEE;
  --success-color: #52C41A;
  --warning-color: #FAAD14;
  --error-color: #FF4D4F;
  --info-color: #1890FF;
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  --shadow-xl: 0 12rpx 32rpx rgba(0, 0, 0, 0.1);
  --radius-sm: 12rpx;
  --radius-md: 16rpx;
  --radius-lg: 20rpx;
  --radius-xl: 24rpx;
  --radius-full: 999rpx;

  background-color: var(--bg-primary);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* 容器 */
.container {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 通用按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-dark) 100%);
  color: var(--text-primary);
  border-radius: var(--radius-full);
  font-weight: 600;
  font-size: 28rpx;
  padding: 24rpx 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 209, 0, 0.3);
  border: none;
  transition: all 0.2s ease;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 16rpx rgba(255, 209, 0, 0.4);
}

/* 次要按钮 */
.btn-secondary {
  background-color: var(--bg-card);
  color: var(--text-primary);
  border-radius: var(--radius-full);
  font-weight: 500;
  font-size: 28rpx;
  padding: 24rpx 48rpx;
  border: 2rpx solid var(--border-color);
  transition: all 0.2s ease;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary:active {
  background-color: var(--bg-hover);
}

/* 卡片样式 */
.card {
  background-color: var(--bg-card);
  border-radius: var(--radius-xl);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  transition: all 0.2s ease;
}

.card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-lg);
}

/* 分割线 */
.divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent, var(--border-color), transparent);
  margin: 24rpx 0;
}

/* 文本样式 */
.text-primary {
  color: var(--primary-color);
}

.text-secondary {
  color: var(--text-secondary);
}

.text-hint {
  color: var(--text-hint);
}

.text-small {
  font-size: 24rpx;
}

.text-bold {
  font-weight: 600;
}

/* 标签样式 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 500;
}

.tag-primary {
  background-color: var(--primary-light);
  color: #E65100;
}

.tag-success {
  background-color: #E8F5E9;
  color: #2E7D32;
}

.tag-warning {
  background-color: #FFF3E0;
  color: #E65100;
}

.tag-error {
  background-color: #FFF2F0;
  color: #C62828;
}

.tag-info {
  background-color: #E3F2FD;
  color: #1565C0;
}

/* Flex 布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

/* 动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(100%);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

/* 加载动画 */
.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid rgba(255, 209, 0, 0.2);
  border-top-color: var(--primary-color);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

/* 安全区域 */
.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 滚动条隐藏 */
::-webkit-scrollbar {
  display: none;
}

/* 输入框焦点效果 */
.input-focus {
  border-color: rgba(255, 209, 0, 0.3) !important;
  box-shadow: 0 0 0 6rpx rgba(255, 209, 0, 0.08) !important;
}

/* 禁用状态 */
.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* 渐变文字 */
.gradient-text {
  background: linear-gradient(135deg, #FFD100, #FF6B00);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

/* 毛玻璃效果 */
.glass-effect {
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

/* 渐变边框 */
.gradient-border {
  position: relative;
}

.gradient-border::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: inherit;
  padding: 2rpx;
  background: linear-gradient(135deg, #FFD100, #FF6B00);
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
}

/* 点击波纹效果 */
.ripple-effect {
  position: relative;
  overflow: hidden;
}

.ripple-effect::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  background: rgba(255, 209, 0, 0.3);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  transition: width 0.3s, height 0.3s;
}

.ripple-effect:active::after {
  width: 200%;
  height: 200%;
}
