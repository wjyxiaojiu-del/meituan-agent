/* pages/index/index.wxss */

.container {
  padding: 0;
  padding-bottom: 200rpx;
  background: linear-gradient(180deg, #FFF8E1 0%, #F8F9FA 25%, #F5F5F5 100%);
  min-height: 100vh;
}

/* 欢迎区域 */
.welcome-section {
  position: relative;
  padding: 48rpx 32rpx 40rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.welcome-bg {
  position: absolute;
  top: -100rpx;
  left: -50rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255, 209, 0, 0.2) 0%, transparent 70%);
  z-index: 0;
  animation: float 6s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translate(0, 0); }
  50% { transform: translate(20rpx, -20rpx); }
}

.welcome-content {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  margin-bottom: 36rpx;
}

.avatar-wrapper {
  position: relative;
  margin-right: 28rpx;
}

.avatar-ring {
  position: absolute;
  top: -6rpx;
  left: -6rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 209, 0, 0.3);
  animation: ring-pulse 2s ease-in-out infinite;
}

@keyframes ring-pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.1); opacity: 0.5; }
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #FFD100 0%, #FFC000 50%, #FFB800 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  box-shadow: 0 12rpx 32rpx rgba(255, 209, 0, 0.35);
  position: relative;
  z-index: 1;
}

.online-dot {
  position: absolute;
  bottom: 2rpx;
  right: 2rpx;
  width: 24rpx;
  height: 24rpx;
  background-color: #52C41A;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
}

.online-pulse {
  width: 24rpx;
  height: 24rpx;
  background-color: rgba(82, 196, 26, 0.4);
  border-radius: 50%;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 0.4; }
  50% { transform: scale(1.5); opacity: 0; }
}

.welcome-text {
  flex: 1;
}

.greeting {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #1A1A1A;
  margin-bottom: 12rpx;
  letter-spacing: 1rpx;
}

.subtitle-wrapper {
  display: flex;
  align-items: center;
}

.subtitle {
  font-size: 26rpx;
  color: #888888;
  letter-spacing: 0.5rpx;
}

.typing-cursor {
  width: 3rpx;
  height: 24rpx;
  background-color: #FFD100;
  margin-left: 4rpx;
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.welcome-features {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.9) 0%, rgba(255, 255, 255, 0.7) 100%);
  border-radius: 24rpx;
  padding: 28rpx 20rpx;
  backdrop-filter: blur(20px);
  border: 1rpx solid rgba(255, 209, 0, 0.15);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.04);
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  flex: 1;
}

.feature-icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #FFF8E1 0%, #FFECB3 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-icon {
  font-size: 32rpx;
}

.feature-text {
  font-size: 22rpx;
  color: #666666;
  font-weight: 600;
}

.feature-divider {
  width: 1rpx;
  height: 48rpx;
  background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.06), transparent);
}

/* 快捷入口 */
.quick-entry {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title-wrapper {
  display: flex;
  align-items: center;
}

.section-title-bar {
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #FFD100, #FFB800);
  border-radius: 3rpx;
  margin-right: 14rpx;
}

.section-title-bar.hot {
  background: linear-gradient(180deg, #FF6B00, #FF4500);
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.section-more-wrapper {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  background-color: #F5F5F5;
  border-radius: 20rpx;
}

.section-more {
  font-size: 24rpx;
  color: #999999;
}

.section-arrow {
  font-size: 28rpx;
  color: #CCCCCC;
  margin-left: 4rpx;
}

.hot-badge {
  background: linear-gradient(135deg, #FF6B00, #FF4500);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.hot-badge text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.entry-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.entry-item {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  transition: all 0.2s ease;
}

.entry-item:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.entry-icon-wrapper {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #FFF8E1 0%, #FFECB3 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 209, 0, 0.15);
}

.entry-icon {
  font-size: 44rpx;
}

.entry-info {
  flex: 1;
  min-width: 0;
}

.entry-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 8rpx;
}

.entry-desc {
  display: block;
  font-size: 24rpx;
  color: #999999;
}

.entry-arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #DDDDDD;
  font-size: 36rpx;
  flex-shrink: 0;
}

/* 热门推荐 */
.hot-section {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.hot-scroll {
  white-space: nowrap;
  margin: 0 -32rpx;
  padding: 0 32rpx;
}

.hot-item {
  display: inline-flex;
  flex-direction: column;
  width: 260rpx;
  margin-right: 20rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  transition: all 0.2s ease;
}

.hot-item:active {
  transform: scale(0.96);
}

.hot-cover {
  width: 100%;
  height: 160rpx;
  background: linear-gradient(135deg, #FFD100 0%, #FFC000 50%, #FFB800 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.hot-emoji {
  font-size: 64rpx;
  position: relative;
  z-index: 1;
}

.hot-cover-bg {
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 100rpx;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.hot-info {
  padding: 20rpx;
}

.hot-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 12rpx;
}

.hot-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.hot-tag {
  font-size: 20rpx;
  color: #FF6B00;
  background-color: #FFF3E0;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  font-weight: 500;
}

.hot-arrow {
  font-size: 28rpx;
  color: #CCCCCC;
}

/* 使用提示 */
.tips-section {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.tips-card {
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: flex-start;
  border: 1rpx solid rgba(33, 150, 243, 0.1);
}

.tips-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.tips-content {
  flex: 1;
}

.tips-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1565C0;
  margin-bottom: 8rpx;
}

.tips-desc {
  display: block;
  font-size: 24rpx;
  color: #42A5F5;
  line-height: 1.6;
}

/* 输入区域 */
.input-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.95), #FFFFFF);
  padding: 20rpx 32rpx 28rpx;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
  backdrop-filter: blur(20px);
}

.input-box {
  display: flex;
  align-items: center;
  background-color: #F5F5F5;
  border-radius: 52rpx;
  padding: 12rpx 12rpx 12rpx 28rpx;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.input-box:focus-within {
  background-color: #FFFFFF;
  border-color: rgba(255, 209, 0, 0.3);
  box-shadow: 0 0 0 6rpx rgba(255, 209, 0, 0.08);
}

.input-prefix {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  opacity: 0.6;
}

.input-field {
  flex: 1;
  height: 72rpx;
  font-size: 28rpx;
  color: #1A1A1A;
}

.input-placeholder {
  color: #CCCCCC;
  font-size: 28rpx;
}

.send-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background-color: #E8E8E8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.send-btn.active {
  background: linear-gradient(135deg, #FFD100 0%, #FFC000 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 209, 0, 0.35);
}

.send-btn:active {
  transform: scale(0.9);
}

.send-btn-inner {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background-color: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-btn.active .send-btn-inner {
  background-color: rgba(255, 255, 255, 0.4);
}

.send-icon {
  font-size: 32rpx;
  font-weight: 700;
  color: #CCCCCC;
}

.send-btn.active .send-icon {
  color: #1A1A1A;
}
