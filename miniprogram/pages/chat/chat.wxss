/* pages/chat/chat.wxss */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #F5F5F5;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #FFD100 0%, #FFC000 100%);
  box-shadow: 0 4rpx 16rpx rgba(255, 209, 0, 0.2);
}

.nav-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #1A1A1A;
  font-weight: 300;
}

.nav-title {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nav-title-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.nav-status {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}

.nav-status-dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #52C41A;
  border-radius: 50%;
  margin-right: 8rpx;
}

.nav-status-text {
  font-size: 20rpx;
  color: rgba(26, 26, 26, 0.6);
}

.nav-action {
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  color: #1A1A1A;
  opacity: 0.7;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 24rpx;
  padding-bottom: 200rpx;
}

/* 消息样式 */
.message {
  display: flex;
  margin-bottom: 32rpx;
  animation: messageIn 0.3s ease-out;
}

@keyframes messageIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.message.user {
  flex-direction: row-reverse;
}

.message-avatar {
  flex-shrink: 0;
  margin: 0 16rpx;
}

.avatar-user {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #FFD100 0%, #FFC000 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 209, 0, 0.3);
}

.avatar-ai {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  box-shadow: 0 6rpx 20rpx rgba(33, 150, 243, 0.15);
}

.message-bubble {
  max-width: 75%;
  min-width: 120rpx;
}

/* 欢迎卡片 */
.welcome-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #FAFAFA 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.welcome-header {
  margin-bottom: 24rpx;
}

.welcome-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.welcome-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.welcome-subtitle {
  font-size: 26rpx;
  color: #888888;
}

.welcome-features {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.feature-chip {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, #FFF8E1 0%, #FFECB3 100%);
  border-radius: 24rpx;
  border: 1rpx solid rgba(255, 209, 0, 0.2);
}

.feature-chip-icon {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.feature-chip-text {
  font-size: 22rpx;
  color: #E65100;
  font-weight: 500;
}

.welcome-hint {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  align-items: flex-start;
}

.hint-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.hint-text {
  font-size: 24rpx;
  color: #2E7D32;
  line-height: 1.6;
}

/* 文本消息 */
.text-content {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

.message.user .text-content {
  background: linear-gradient(135deg, #FFD100 0%, #FFC000 100%);
  box-shadow: 0 6rpx 20rpx rgba(255, 209, 0, 0.25);
  border: none;
}

.text-content text {
  font-size: 28rpx;
  line-height: 1.8;
  color: #1A1A1A;
}

.message-meta {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
}

.message.user .message-meta {
  border-top-color: rgba(255, 255, 255, 0.2);
}

.message-time {
  font-size: 20rpx;
  color: #CCCCCC;
}

.message.user .message-time {
  color: rgba(26, 26, 26, 0.5);
}

/* 加载消息 */
.loading-content {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
}

.loading-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.loading-animation {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-right: 16rpx;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  background: linear-gradient(135deg, #FFD100, #FFC000);
  border-radius: 50%;
  animation: bounce 1.4s infinite ease-in-out;
}

.loading-dot:nth-child(1) { animation-delay: -0.32s; }
.loading-dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

.loading-label {
  font-size: 26rpx;
  color: #888888;
  font-weight: 500;
}

.loading-steps {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-left: 8rpx;
}

.loading-step {
  display: flex;
  align-items: center;
  opacity: 0.4;
}

.loading-step.active {
  opacity: 1;
}

.step-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #E0E0E0;
  margin-right: 16rpx;
}

.loading-step.active .step-dot {
  background: linear-gradient(135deg, #FFD100, #FFC000);
  box-shadow: 0 0 0 4rpx rgba(255, 209, 0, 0.2);
}

.loading-step text {
  font-size: 24rpx;
  color: #666666;
}

/* 行程卡片 */
.plan-card {
  background: linear-gradient(135deg, #FFFFFF 0%, #FAFAFA 100%);
  border-radius: 24rpx;
  padding: 0;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  overflow: hidden;
  min-width: 480rpx;
}

.plan-header {
  padding: 28rpx;
  background: linear-gradient(135deg, #F8F9FA 0%, #F0F0F0 100%);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.plan-status-wrapper {
  display: flex;
  align-items: center;
}

.plan-status-icon-bg {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.plan-status-icon-bg.success {
  background: linear-gradient(135deg, #52C41A, #73D13D);
}

.plan-status-icon-bg.partial {
  background: linear-gradient(135deg, #FAAD14, #FFC53D);
}

.plan-status-icon-bg.error {
  background: linear-gradient(135deg, #FF4D4F, #FF7875);
}

.plan-status-icon {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 700;
}

.plan-status-info {
  flex: 1;
}

.plan-status-text {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  margin-bottom: 4rpx;
}

.plan-status-desc {
  display: block;
  font-size: 22rpx;
  color: #999999;
}

.plan-tasks {
  padding: 20rpx 28rpx;
}

.task-item {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
}

.task-item:not(:last-child) {
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.task-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.task-dot.success {
  background: linear-gradient(135deg, #52C41A, #73D13D);
}

.task-dot.pending {
  background-color: #D9D9D9;
}

.task-name {
  flex: 1;
  font-size: 26rpx;
  color: #666666;
}

.task-status-icon {
  font-size: 24rpx;
  color: #52C41A;
  font-weight: 600;
}

.task-item:last-child .task-status-icon {
  color: #D9D9D9;
}

.plan-actions {
  padding: 20rpx 28rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.04);
  display: flex;
  gap: 16rpx;
}

.plan-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.plan-btn.primary {
  background: linear-gradient(135deg, #FFD100 0%, #FFC000 100%);
  color: #1A1A1A;
  box-shadow: 0 4rpx 16rpx rgba(255, 209, 0, 0.2);
}

.plan-btn:active {
  transform: scale(0.96);
}

.btn-arrow {
  margin-left: 8rpx;
  font-size: 28rpx;
}

/* 待确认方案卡片 */
.plan-confirm-card {
  border: 2rpx solid rgba(255, 209, 0, 0.3);
}

.plan-status-icon-bg.waiting {
  background: linear-gradient(135deg, #FFD100, #FFC000);
}

.plan-summary-section {
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.plan-summary-text {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.8;
  display: block;
}

.task-tool {
  font-size: 20rpx;
  color: #CCCCCC;
  margin-left: 12rpx;
}

.plan-btn.cancel {
  background-color: #F5F5F5;
  color: #999999;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.plan-btn.confirm {
  background: linear-gradient(135deg, #52C41A, #73D13D);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(82, 196, 26, 0.3);
}

/* 输入区域 */
.input-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.95), #FFFFFF);
  padding: 16rpx 24rpx 24rpx;
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
  backdrop-filter: blur(20px);
}

.input-wrapper {
  display: flex;
  flex-direction: column;
}

.input-box {
  display: flex;
  align-items: center;
  background-color: #F5F5F5;
  border-radius: 48rpx;
  padding: 12rpx 12rpx 12rpx 28rpx;
  transition: all 0.3s ease;
  border: 2rpx solid transparent;
}

.input-box:focus-within {
  background-color: #FFFFFF;
  border-color: rgba(255, 209, 0, 0.3);
  box-shadow: 0 0 0 6rpx rgba(255, 209, 0, 0.08);
}

.input-field {
  flex: 1;
  height: 68rpx;
  font-size: 28rpx;
  color: #1A1A1A;
}

.input-placeholder {
  color: #CCCCCC;
  font-size: 28rpx;
}

.send-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background-color: #E8E8E8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.send-btn.active {
  background: linear-gradient(135deg, #FFD100 0%, #FFC000 100%);
  box-shadow: 0 6rpx 20rpx rgba(255, 209, 0, 0.3);
}

.send-btn:active {
  transform: scale(0.9);
}

.send-icon {
  font-size: 32rpx;
  font-weight: 700;
  color: #CCCCCC;
}

.send-btn.active .send-icon {
  color: #1A1A1A;
}

.input-hints {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 0 8rpx;
}

.hint-tag {
  padding: 10rpx 20rpx;
  background-color: #F5F5F5;
  border-radius: 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.hint-tag:active {
  background-color: #EEEEEE;
}

.hint-tag text {
  font-size: 22rpx;
  color: #666666;
}

/* ===== P6: Plan-confirm task layout (with caps + diff state) ===== */
.task-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.task-main .task-name {
  font-size: 26rpx;
  color: #1A1A1A;
  font-weight: 500;
  flex: none;
}

.task-main .task-tool {
  font-size: 20rpx;
  color: #BBBBBB;
  margin-left: 0;
}

.task-caps {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  align-items: center;
}

.task-cap {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  line-height: 1.4;
  background-color: #F0F0F0;
  color: #666666;
}

.task-cap.cap-coupon,
.task-cap.cap-团购券 {
  background: linear-gradient(135deg, #FFF8E1, #FFECB3);
  color: #E65100;
  border: 1rpx solid rgba(255, 209, 0, 0.3);
}

.task-cap.cap-闪送 {
  background: linear-gradient(135deg, #E3F2FD, #BBDEFB);
  color: #1565C0;
  border: 1rpx solid rgba(33, 150, 243, 0.3);
}

.task-cap.cap-会员折扣 {
  background: linear-gradient(135deg, #F3E5F5, #E1BEE7);
  color: #7B1FA2;
  border: 1rpx solid rgba(156, 39, 176, 0.3);
}

.task-cap.cap-扫码点餐 {
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
  color: #2E7D32;
  border: 1rpx solid rgba(76, 175, 80, 0.3);
}

.task-cap.cap-免预约 {
  background: linear-gradient(135deg, #FFF3E0, #FFE0B2);
  color: #E65100;
  border: 1rpx solid rgba(255, 152, 0, 0.3);
}

.task-cap.cap-秒杀 {
  background: linear-gradient(135deg, #FFEBEE, #FFCDD2);
  color: #C62828;
  border: 1rpx solid rgba(244, 67, 54, 0.3);
}

.task-cap.cap-积分 {
  background-color: #ECEFF1;
  color: #546E7A;
}

/* Diff state highlights */
.task-item.replaced {
  background-color: rgba(255, 209, 0, 0.08);
  border-radius: 12rpx;
  padding-left: 14rpx;
  padding-right: 14rpx;
  border-bottom-color: transparent;
}

.task-item.inserted {
  background-color: rgba(82, 196, 26, 0.08);
  border-radius: 12rpx;
  padding-left: 14rpx;
  padding-right: 14rpx;
  border-bottom-color: transparent;
}

.task-item.shifted {
  background-color: rgba(33, 150, 243, 0.08);
  border-radius: 12rpx;
  padding-left: 14rpx;
  padding-right: 14rpx;
  border-bottom-color: transparent;
}

.task-diff-tag {
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #FFD100, #FFC000);
  color: #1A1A1A;
  font-weight: 700;
  margin-left: 12rpx;
  flex-shrink: 0;
  align-self: flex-start;
}

.task-item.inserted .task-diff-tag {
  background: linear-gradient(135deg, #52C41A, #73D13D);
  color: #FFFFFF;
}

.task-item.shifted .task-diff-tag {
  background: linear-gradient(135deg, #2196F3, #64B5F6);
  color: #FFFFFF;
}

/* ===== P6: Error card (plan_modify_failed) ===== */
.error-card {
  background: linear-gradient(135deg, #FFF5F5 0%, #FFEBEE 100%);
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(244, 67, 54, 0.15);
  box-shadow: 0 4rpx 16rpx rgba(244, 67, 54, 0.06);
}

.error-header {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.error-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  background: linear-gradient(135deg, #FF4D4F, #FF7875);
  color: #FFFFFF;
  border-radius: 12rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.error-text {
  flex: 1;
  font-size: 26rpx;
  color: #1A1A1A;
  line-height: 1.6;
}

.error-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.error-chip {
  padding: 10rpx 20rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  border: 1rpx solid rgba(244, 67, 54, 0.2);
}

.error-chip:active {
  background-color: #FFEBEE;
  transform: scale(0.96);
}

.error-chip text {
  font-size: 24rpx;
  color: #C62828;
  font-weight: 500;
}

.error-card .message-meta {
  border-top-color: rgba(244, 67, 54, 0.1);
  margin-top: 16rpx;
}
